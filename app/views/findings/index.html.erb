<% content_for :title, "Findings" %>

<h1>Findings</h1>
<p class="text-muted">
  What the sweeps have shown so far. Every claim is written against its own runs, and
  every run keeps its seed, so any of them can be re-run.
</p>

<% if @index.any? %>
  <ul class="finding-list">
    <% @index.rows.each do |row| %>
      <li class="finding-card">
        <p class="finding-meta text-sm text-muted">
          <span class="badge <%= row.finding.badge_class %>"><%= row.finding.status_label %></span>
          <time datetime="<%= row.finding.date.iso8601 %>"><%= l row.finding.date, format: :long %></time>
        </p>
        <h2 class="finding-title"><%= link_to row.finding.title, finding_path(row.finding) %></h2>
        <p><%= row.finding.summary %></p>
        <p class="text-sm">
          <% if row.experiment? %>
            Sweep: <%= link_to row.experiment.name, experiment_path(row.experiment) %>
          <% else %>
            <span class="text-muted">Sweep <span class="mono"><%= row.finding.experiment_slug %></span> is not in the lab yet.</span>
          <% end %>
        </p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-muted">Nothing has been published yet.</p>
<% end %>
