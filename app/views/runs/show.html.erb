<% content_for :title, "Run ##{@show.run.id}" %>

<h1>Run #<%= @show.run.id %></h1>
<p class="text-muted">
  <%= link_to @show.run.experiment.name, experiment_path(@show.run.experiment) %> —
  <% if @show.arm_label %><%= @show.arm_label %>, <% end %><%= @show.run.experiment.substrate %> substrate, seed <span class="mono"><%= @show.run.seed %></span>.
  The seed and the parameters below reproduce this run byte for byte.
</p>

<% if @show.findings.any? %>
  <p class="text-sm">
    Cited by:
    <% @show.findings.each do |finding| %>
      <%= link_to finding.title, finding_path(finding) %>
      <span class="badge <%= finding.badge_class %>"><%= finding.status_label %></span>
    <% end %>
  </p>
<% end %>

<%= render "progress", show: @show, polling: !@show.run.terminal? %>

<% if @show.run.error.present? %>
  <p class="alert alert-error"><%= @show.run.error %></p>
<% end %>

<% if @show.persistence %>
  <% persistence = @show.persistence %>
  <h2>Persistence</h2>
  <p class="text-muted">
    What became of the world after the transition at epoch
    <%= number_with_delimiter @show.run.transition_epoch %>, read off this run's stored samples by the
    engine's own transition rule: a transition is a state a world can leave.
  </p>
  <dl class="facts">
    <dt>census peak</dt>
    <dd class="mono"><%= persistence.counted? ? number_with_delimiter(persistence.census_peak) : "0 (no replicator counted)" %></dd>
    <dt>peak epoch</dt>
    <dd class="mono"><%= persistence.peak_epoch ? number_with_delimiter(persistence.peak_epoch) : "—" %></dd>
    <dt>epochs persisted</dt>
    <dd class="mono"><%= number_with_delimiter persistence.epochs_persisted %></dd>
    <dt>outcome</dt>
    <dd>
      <% if persistence.relapsed? %>
        <span class="badge badge-warning">relapsed</span>
        the world climbed back out of the transitioned state before its last sample
      <% else %>
        <span class="badge badge-success">persisted</span>
        the world was still in the transitioned state at its last sample
      <% end %>
    </dd>
  </dl>
<% end %>

<h2>Metrics</h2>
<p><%= link_to "Download CSV", samples_run_path(@show.run, format: :csv), class: "btn btn-sm btn-outline" %></p>
<% if @show.charts_empty? %>
  <p class="text-muted">This run has not reported a sample yet.</p>
<% else %>
  <div class="chart-grid-2">
    <% @show.charts.each do |chart| %>
      <%= render chart %>
    <% end %>
  </div>
<% end %>

<h2>Snapshots</h2>
<% if @show.snapshots.any? %>
  <div class="snapshot-gallery">
    <% @show.snapshots.each do |snapshot| %>
      <figure class="snapshot">
        <%= image_tag png_snapshot_path(snapshot), alt: "World at epoch #{snapshot.epoch}", loading: "lazy" %>
        <figcaption class="text-sm text-muted">
          epoch <%= number_with_delimiter snapshot.epoch %> <span class="text-xs">(<%= snapshot.reason %>)</span>
        </figcaption>
      </figure>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">No snapshot has been uploaded for this run yet.</p>
<% end %>

<h2>Parameters</h2>
<dl class="facts mono">
  <dt>seed</dt><dd><%= @show.run.seed %></dd>
  <% @show.params.each do |key, value| %>
    <dt><%= key %></dt><dd><%= param_value(value) %></dd>
  <% end %>
</dl>
