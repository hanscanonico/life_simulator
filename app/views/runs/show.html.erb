<% content_for :title, "Run ##{@show.run.id}" %>

<h1>Run #<%= @show.run.id %></h1>
<p class="text-muted">
  <%= link_to @show.run.experiment.name, experiment_path(@show.run.experiment) %> —
  seed <span class="mono"><%= @show.run.seed %></span>. The seed and the parameters below
  reproduce this run byte for byte.
</p>

<dl class="facts">
  <dt>Status</dt><dd><span class="badge"><%= @show.run.status %></span></dd>
  <dt>Progress</dt>
  <dd><%= number_with_delimiter @show.run.epochs_done %> / <%= number_with_delimiter @show.run.epochs %> epochs
    (<%= @show.progress %>%)</dd>
  <dt>Transition epoch</dt>
  <dd><%= @show.transition_label %></dd>
  <dt>Runner</dt>
  <dd>
    <%= @show.run.runner_id || "—" %><% if !@show.run.terminal? && @show.run.heartbeat_at.present? %>,
      last heartbeat <%= time_ago_in_words @show.run.heartbeat_at %> ago<% end %>
  </dd>
</dl>

<% if @show.run.error.present? %>
  <p class="alert alert-error"><%= @show.run.error %></p>
<% end %>

<h2>Metrics</h2>
<p><%= link_to "Download CSV", samples_run_path(@show.run, format: :csv), class: "btn btn-sm btn-outline" %></p>
<% if @show.charts_empty? %>
  <p class="text-muted">This run has not reported a sample yet.</p>
<% else %>
  <div class="chart-grid-2">
    <% @show.charts.each do |chart| %>
      <%= render chart %>
    <% end %>
  </div>
<% end %>

<h2>Snapshots</h2>
<% if @show.snapshots.any? %>
  <div class="snapshot-gallery">
    <% @show.snapshots.each do |snapshot| %>
      <figure class="snapshot">
        <%= image_tag png_snapshot_path(snapshot), alt: "World at epoch #{snapshot.epoch}", loading: "lazy" %>
        <figcaption class="text-sm text-muted">epoch <%= number_with_delimiter snapshot.epoch %></figcaption>
      </figure>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">No snapshot has been uploaded for this run yet.</p>
<% end %>

<h2>Parameters</h2>
<dl class="facts mono">
  <dt>seed</dt><dd><%= @show.run.seed %></dd>
  <% @show.params.each do |key, value| %>
    <dt><%= key %></dt><dd><%= param_value(value) %></dd>
  <% end %>
</dl>
