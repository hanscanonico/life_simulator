<turbo-frame id="lab_status">
  <section class="lab-status">
    <div class="flex items-center gap-2 mb-4">
      <%= link_to "Refresh", lab_status_path, class: "btn btn-sm btn-outline" %>
      <time class="text-sm text-muted" datetime="<%= @status.fetched_at.iso8601 %>"
            data-controller="relative-time"
            data-relative-time-datetime-value="<%= @status.fetched_at.iso8601 %>">updated just now</time>
    </div>

    <h2>Runs</h2>
    <dl class="facts">
      <% @status.counts_by_status.each do |status, count| %>
        <dt><%= status %></dt><dd><%= number_with_delimiter count %></dd>
      <% end %>
      <dt>total</dt><dd><%= number_with_delimiter @status.total_runs %></dd>
    </dl>
    <% if @status.stale_heartbeat_count.positive? %>
      <p class="text-muted">
        <%= @status.live_run_count %> running,
        <%= @status.stale_heartbeat_count %> with a stale heartbeat: no runner holds those
        any more, so they are under "Worth a look" rather than in the table below.
      </p>
    <% end %>

    <h2>Runners holding a run right now</h2>
    <% if @status.expected_slots %>
      <p class="text-muted">
        <%= @status.expected_slots %> slots expected,
        <%= @status.live_runners.size %> live,
        <%= @status.idle_slots %> idle<% if @status.superseded_runners.any? %>,
          <%= @status.superseded_runners.size %> stale (superseded runner)<% end %>.
      </p>
    <% end %>
    <% if @status.departed_slots.positive? %>
      <p class="text-muted">
        <%= pluralize @status.departed_slots, "slot" %> from a previous runner still inside
        the heartbeat window.
      </p>
    <% end %>
    <% if @status.runners.any? %>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Runner</th>
              <th>Current run</th>
              <th class="numeric">Epochs done</th>
              <th class="numeric">Epochs/h</th>
              <th>Last heartbeat</th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: "lab/runner_row", collection: @status.live_runners,
                       as: :runner_row %>
          </tbody>
          <% if @status.superseded_runners.any? %>
            <tbody class="text-muted">
              <tr>
                <td colspan="5">
                  <%= pluralize @status.superseded_runners.size, "slot" %> of a superseded
                  runner: the heartbeat stopped, so these are out of the counts above and
                  their runs are released on the next claim.
                </td>
              </tr>
              <%= render partial: "lab/runner_row", collection: @status.superseded_runners,
                         as: :runner_row %>
            </tbody>
          <% end %>
        </table>
      </div>
    <% else %>
      <p class="text-muted">No runner is holding a run right now.</p>
    <% end %>

    <h2>Throughput</h2>
    <p><%= number_with_delimiter @status.epochs_per_hour %> epochs in the last hour.</p>

    <h2>Oldest pending run</h2>
    <% if @status.oldest_pending %>
      <p>
        <%= link_to "Run ##{@status.oldest_pending.id}", run_path(@status.oldest_pending) %>,
        queued <%= time_ago_in_words(@status.oldest_pending.created_at) %> ago,
        priority <%= @status.oldest_pending.priority %>.
      </p>
    <% else %>
      <p class="text-muted">The queue is empty.</p>
    <% end %>

    <h2>Worth a look</h2>
    <% if @status.worth_a_look.any? %>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Run</th>
              <th>Runner</th>
              <th class="numeric">Epochs done</th>
              <th>Why</th>
            </tr>
          </thead>
          <tbody>
            <% @status.worth_a_look.each do |flagged| %>
              <tr>
                <td><%= link_to "Run ##{flagged.run.id}", run_path(flagged.run) %></td>
                <td class="mono"><%= flagged.run.runner_id %></td>
                <td class="numeric"><%= number_with_delimiter flagged.run.epochs_done %></td>
                <td>
                  <% if flagged.stale_heartbeat? %>
                    heartbeat stale for <%= time_ago_in_words(flagged.since) %>
                    (will release on the next claim)
                  <% else %>
                    no progress for <%= time_ago_in_words(flagged.since) %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-muted">None.</p>
    <% end %>

    <% if @status.recent_failure_count.positive? %>
      <h2>Recent failures</h2>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Run</th>
              <th>Failed</th>
              <th>Runner</th>
              <th>Error</th>
            </tr>
          </thead>
          <tbody>
            <% @status.recent_failures.each do |failure| %>
              <tr>
                <td><%= link_to "Run ##{failure.id}", run_path(failure.id) %></td>
                <td><%= time_ago_in_words(failure.finished_at) %> ago</td>
                <td class="mono"><%= failure.runner_id %></td>
                <td><%= truncate(failure.error, length: 120) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @status.recent_failure_count > @status.recent_failures.size %>
        <p class="text-muted">
          The <%= @status.recent_failures.size %> most recent of
          <%= @status.recent_failure_count %>.
        </p>
      <% end %>
    <% end %>
  </section>
</turbo-frame>
