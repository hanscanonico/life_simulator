<% content_for :title, "Experiments" %>

<h1>Experiments</h1>
<p class="text-muted">
  Every sweep of the research programme, with the share of finished runs in which a
  self-replicator emerged.
</p>

<% if @index.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Sweep</th>
        <th>Substrate</th>
        <th>Status</th>
        <th class="numeric">Runs done</th>
        <th class="numeric">Transition rate</th>
      </tr>
    </thead>
    <tbody>
      <% @index.rows.each do |row| %>
        <tr>
          <td><%= link_to row.experiment.name, experiment_path(row.experiment) %></td>
          <td><%= row.experiment.substrate %></td>
          <td><span class="badge"><%= row.experiment.status %></span></td>
          <td class="numeric"><%= row.runs_done %> / <%= row.runs_total %></td>
          <td class="numeric">
            <%= row.transition_rate ? number_to_percentage(row.transition_rate * 100, precision: 0) : "—" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No experiment has been queued yet.</p>
<% end %>
