<% content_for :title, "Experiments" %>

<h1>Experiments</h1>
<p class="text-muted">
  Every sweep of the research programme, with the share of finished runs the transition
  detector flagged: a <span class="mono">compress_ratio</span> collapse that held. A
  flagged run is not by itself a replicator census — see
  <%= link_to "the findings", findings_path %>.
</p>

<% if @index.any? %>
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>Sweep</th>
          <th>Substrate</th>
          <th>Status</th>
          <th class="numeric">Runs done</th>
          <th class="numeric">Transition rate</th>
        </tr>
      </thead>
      <tbody>
        <% @index.rows.each do |row| %>
          <tr>
            <td><%= link_to row.experiment.name, experiment_path(row.experiment) %></td>
            <td><%= row.experiment.substrate %></td>
            <td><span class="badge <%= status_badge_class(row.experiment.status) %>"><%= row.experiment.status %></span></td>
            <td class="numeric"><%= row.runs_done %> / <%= row.runs_total %></td>
            <td class="numeric">
              <%= percent_value row.transition_rate.fraction %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-muted">No sweep has been queued yet; the programme below is what is planned.</p>
<% end %>

<% if @index.planned.any? %>
  <h2>Not queued yet</h2>
  <dl class="facts facts-prose">
    <% @index.planned.each do |sweep| %>
      <dt><%= sweep.name %></dt>
      <dd><%= sweep.description %></dd>
    <% end %>
  </dl>
<% end %>
