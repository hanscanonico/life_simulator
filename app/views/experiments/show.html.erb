<% content_for :title, @show.experiment.name %>
<% content_for :description, @show.experiment.description %>

<h1><%= @show.experiment.name %></h1>
<p class="text-muted"><%= @show.experiment.description %></p>

<dl class="facts">
  <dt>Substrate</dt><dd><%= @show.experiment.substrate %></dd>
  <dt>Status</dt><dd><%= @show.experiment.status %></dd>
  <dt>Epochs per run</dt><dd><%= number_with_delimiter @show.experiment.epochs %></dd>
  <dt>Runs finished</dt><dd><%= @show.finished_count %> / <%= @show.experiment.runs_count %></dd>
  <dt>Transition rate</dt>
  <dd>
    <% if @show.transition_rate.fraction %>
      <%= @show.transitioned_finished %> of <%= @show.finished_count %> finished runs transitioned
      (<%= percent_value @show.transition_rate.fraction %>)
    <% else %>
      no finished run yet
    <% end %>
    <% if @show.transitioned_running.positive? %>
      <span class="text-muted">
        (+<%= pluralize(@show.transitioned_running, "run") %> still under way already transitioned)
      </span>
    <% end %>
  </dd>
</dl>

<% if @show.axes.any? %>
  <% @show.arms.each do |axis, arms| %>
    <%= render @show.diagram_for(axis) %>
    <% if @show.finished_count.positive? %>
      <%= render "experiments/arms_table", axis: axis, arms: arms %>
    <% end %>
    <% survival = @show.survivals.fetch(axis) %>
    <%= render survival %>
    <% unless survival.empty? %>
      <%= render "experiments/hazard_table", axis: axis, survival: survival %>
    <% end %>
  <% end %>
<% else %>
  <p class="text-muted">This experiment sweeps no parameter, so it has no phase diagram.</p>
<% end %>

<% if @show.transition_report? %>
  <div class="chart-grid-2">
    <%= render @show.agreement_chart %>
    <%= render "experiments/transition_report", arms: @show.transition_arms,
                                                threshold: @show.transition_threshold %>
  </div>
<% end %>

<h2>Runs</h2>
<p class="flex flex-wrap gap-2">
  <%= link_to "Download CSV", experiment_path(@show.experiment, format: :csv), class: "btn btn-sm btn-outline" %>
  <% if @show.transition_report? %>
    <%= link_to "Download transition report (CSV)", transitions_experiment_path(@show.experiment),
                class: "btn btn-sm btn-outline" %>
  <% end %>
</p>
<%= render "experiments/runs_table", page: @show %>
