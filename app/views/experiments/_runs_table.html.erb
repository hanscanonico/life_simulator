<%# The runs behind a sweep, seeds first: shared by the experiment page and any finding
    that rests on it. `page` is an Experiments::ShowPage. %>
<div class="table-scroll">
  <table class="data-table">
    <thead>
      <tr>
        <th class="numeric">Seed</th>
        <% page.arm_columns.each do |column| %>
          <th class="numeric"><%= column %></th>
        <% end %>
        <th>Status</th>
        <th class="numeric">Priority</th>
        <th class="numeric">Epochs done</th>
        <th class="numeric">Transition epoch</th>
        <th class="numeric">Census</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% page.runs.each do |run| %>
        <tr>
          <td class="numeric mono"><%= run.seed %></td>
          <% page.arm_labels_of(run).each do |label| %>
            <td class="numeric mono"><%= label || "—" %></td>
          <% end %>
          <td><span class="badge"><%= run.status %></span></td>
          <td class="numeric"><%= run.priority %></td>
          <td class="numeric"><%= number_with_delimiter run.epochs_done %></td>
          <td class="numeric"><%= epoch_value run.transition_epoch %></td>
          <td class="numeric">
            <% if (census = page.census_of(run)) %>
              <%= count_value census.peak %>
              <% if census.detector_only? %>
                <span class="badge badge-warning">detector only</span>
              <% elsif census.census_only? %>
                <span class="badge badge-info">census only</span>
              <% end %>
            <% end %>
          </td>
          <td><%= link_to "Run", run_path(run) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if page.pagy.pages > 1 %>
  <nav class="pagination"><%== page.pagy.series_nav %></nav>
<% end %>
