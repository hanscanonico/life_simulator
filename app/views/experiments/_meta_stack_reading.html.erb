<%# The meta-stack sweep's pre-registered reading (docs/design_record.md, 2026-10-02,
    "Meta-stack: does a soup assemble the deep rungs from paid parts on a metabolism tape
    read with a stack NAND?"): `reading` is a Lab::MetaStackReading::Report. The per-child
    rows stay in `lab:meta_stack_report`. %>
<section class="mt-6" id="meta-stack-reading">
  <h2>
    The pre-registered reading
    <% if reading.any? %>
      <span class="badge <%= reading.interim? ? 'badge-warning' : 'badge-success' %>">
        <%= reading.interim? ? "interim" : "final" %>
      </span>
    <% end %>
    <%= render "findings/objective_badge" %>
  </h2>
  <p class="text-sm text-muted">
    <% if reading.interim? %>
      Interim: not every child of every qualifying parent has finished, here and in the
      <%= link_to "Logic", experiment_path(Lab.slug_for(Lab::MetaStackReading::TWIN_SWEEP)) %> sweep whose
      children are the twins, and nothing here is the sweep's result yet.
    <% else %>
      Every child of every qualifying parent has finished, here and in the Logic sweep.
    <% end %>
    Each child is paired with the child of the same parent and seed in another arm: the Logic
    sweep's unpaid child and its paid child on the woven tape are the twins from that sweep. All
    are read over their own samples past a settling window of
    <%= number_with_delimiter Lab::MetaStackReading::SETTLING_WINDOW %> epochs. A child is extinct
    where its last-decile median share of replicators on the replicating tape is below
    <%= percent_value Lab::MetaStackReading::EXTINCT_SHARE %>, and a pair with an extinct child is
    in no test. Each test is a one-sided sign test at p &lt; <%= Lab::MetaStackReading::SIGN_TEST_LEVEL %>,
    re-read with the extinct pairs kept and without the parents the design study piloted (runs
    <%= Lab::MetaStackReading::PILOT_PARENTS.to_sentence %>). A deep rung shown here reads as
    assembled from paid parts only where H-stones-Ms is shown too, and as a crossing of several
    steps only where its substitution distance, measured after the sweep, is at least two.
    This substrate imports an objective, a primitive, a hereditary channel and a choice of the
    primitive's semantics made because it lets the deep rungs come, so rung 4 on Soup stays not
    shown whatever it reads.
  </p>

  <% if reading.any? %>
    <figure class="table-figure mt-4">
      <figcaption class="table-caption text-sm text-muted" id="meta-stack-arms">
        Children per arm, read so far. A deep rung is XOR or EQU held by a tenth of the world for
        <%= Lab::MetaStackReading::PERSISTENCE_RUN %> samples running; a stepping stone is OR, ANDN or
        NOR held first.
      </figcaption>
      <div class="table-scroll" tabindex="0" role="region" aria-labelledby="meta-stack-arms">
        <table class="data-table" aria-labelledby="meta-stack-arms">
          <thead>
            <tr>
              <th>Arm</th>
              <th class="numeric">Children</th>
              <th class="numeric">Finished</th>
              <th class="numeric">Settled relapses</th>
              <th class="numeric">Extinct</th>
              <th class="numeric">Capability measured</th>
              <th class="numeric">Reached a deep rung</th>
              <th class="numeric">Through a stepping stone</th>
              <th class="numeric">Complexity survivors</th>
              <th class="numeric">Rises</th>
            </tr>
          </thead>
          <tbody>
            <% reading.arms.each do |arm| %>
              <tr>
                <td><%= arm.name %></td>
                <% arm.cells.drop(1).each do |count| %>
                  <td class="numeric"><%= count %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </figure>

    <h3 class="mt-4">Hypotheses</h3>
    <ul>
      <% reading.readings.each do |test, kept, unpiloted| %>
        <% comparison = test.comparison %>
        <li class="mb-3">
          <strong><%= test.hypothesis %></strong>, <%= test.treatment.name %> against <%= test.control.name %>:
          <span class="badge <%= test.badge_class %>"><%= test.outcome_label %></span>
          <p class="text-sm text-muted">
            <%= pluralize(comparison.measured_count, "pair") %> measured on both sides:
            <%= comparison.favouring %> favour <%= test.treatment.name %>, <%= comparison.against %>
            <%= test.control.name %>,
            <%= comparison.ties %> tie<% if comparison.p_value %>; p = <%= p_value_text comparison.p_value %><% end %>.
            <% if comparison.carried_by.any? %>
              Carried by parents
              <%= comparison.carried_by.map { |parents| parents.map { |id| "run #{id}" }.join(" and ") }.to_sentence(two_words_connector: " or ", last_word_connector: ", or ") %>:
              without their pairs the test falls to p ≥ <%= Lab::MetaStackReading::SIGN_TEST_LEVEL %>.
            <% end %>
            <% [["With the extinct pairs kept", kept], ["Without the piloted parents", unpiloted]].each do |label, sensitivity| %>
              <%= label %>:
              <span class="badge <%= sensitivity.badge_class %>"><%= sensitivity.outcome_label %></span>,
              <%= sensitivity.comparison.favouring %> to <%= sensitivity.comparison.against %><% if sensitivity.comparison.p_value %>,
              p = <%= p_value_text sensitivity.comparison.p_value %><% end %>.
            <% end %>
          </p>
          <% if comparison.agreement.any? %>
            <details class="text-sm">
              <summary>Per-parent agreement</summary>
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Parent</th>
                    <th class="numeric">Favour <%= test.treatment.name %></th>
                    <th class="numeric">Favour <%= test.control.name %></th>
                    <th class="numeric">Tie</th>
                    <th class="numeric">Not both measured</th>
                  </tr>
                </thead>
                <tbody>
                  <% comparison.agreement.each do |row| %>
                    <tr>
                      <td><%= link_to "run #{row.parent_id}", run_path(row.parent_id) %></td>
                      <td class="numeric"><%= row.treatment %></td>
                      <td class="numeric"><%= row.continuation %></td>
                      <td class="numeric"><%= row.ties %></td>
                      <td class="numeric"><%= row.unmeasured %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </details>
          <% end %>
        </li>
      <% end %>
    </ul>

    <details class="text-sm mt-4" id="meta-stack-pairs">
      <summary>The pairs</summary>
      <div class="table-scroll" tabindex="0" role="region" aria-label="The pairs">
        <table class="data-table">
          <thead>
            <tr>
              <th>Parent</th>
              <th class="numeric">Seed</th>
              <% reading.arms.each do |arm| %>
                <th><%= arm.name.capitalize %> child</th>
                <th class="numeric">Capability</th>
                <th class="numeric">Deep capability</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% reading.pairs.each do |parent_id, seed, *twins| %>
              <tr>
                <td><%= link_to "run #{parent_id}", run_path(parent_id) %></td>
                <td class="numeric"><%= seed %></td>
                <% twins.each do |child| %>
                  <% if child %>
                    <td>
                      <%= link_to "run #{child.run_id}", run_path(child.run_id) %>
                      <% if child.extinct? %><span class="text-muted">extinct</span><% end %>
                    </td>
                    <td class="numeric"><%= child.capability(Lab::MetaStackReading::CAPABILITY_KEY) || "—" %></td>
                    <td class="numeric"><%= child.capability(Lab::MetaStackReading::DEEP_CAPABILITY_KEY) || "—" %></td>
                  <% else %>
                    <td class="text-muted">not seeded</td><td class="numeric">—</td><td class="numeric">—</td>
                  <% end %>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>

    <figure class="table-figure mt-4">
      <figcaption class="table-caption text-sm text-muted" id="meta-stack-ladder">
        The ladder, descriptive only: how many children's worlds held each rung at a share of
        <%= percent_value Lab::MetaStackReading::TASK_PRESENT_SHARE %> for
        <%= Lab::MetaStackReading::PERSISTENCE_RUN %> samples running, settling window included, and
        the median first epoch they did.
      </figcaption>
      <div class="table-scroll" tabindex="0" role="region" aria-labelledby="meta-stack-ladder">
        <table class="data-table" aria-labelledby="meta-stack-ladder">
          <thead>
            <tr>
              <th>Rung</th>
              <% reading.arms.each do |arm| %>
                <th class="numeric"><%= arm.name.capitalize %>: children</th>
                <th class="numeric"><%= arm.name.capitalize %>: median first epoch</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% reading.arms.map(&:ladder).transpose.each do |rungs| %>
              <tr>
                <td class="uppercase"><%= rungs.first.task %></td>
                <% rungs.each do |rung| %>
                  <td class="numeric"><%= rung.reached %></td>
                  <td class="numeric"><%= rung.median_first_epoch ? number_with_delimiter(rung.median_first_epoch) : "—" %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </figure>
  <% else %>
    <p class="mt-4">No child yet.</p>
  <% end %>
</section>
