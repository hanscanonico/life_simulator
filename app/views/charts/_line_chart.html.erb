<figure class="chart">
  <figcaption class="chart-title"><%= line_chart.title %></figcaption>
  <% if line_chart.empty? %>
    <p class="chart-empty text-muted">No samples recorded yet.</p>
  <% else %>
    <svg class="chart-svg" viewBox="0 0 <%= line_chart.width %> <%= line_chart.height %>"
         role="img" aria-label="<%= line_chart.title %>" preserveAspectRatio="xMidYMid meet">
      <%= render "charts/axes", chart: line_chart %>
      <% if line_chart.marker_pixel %>
        <g class="chart-marker">
          <line x1="<%= line_chart.marker_pixel.round(2) %>" y1="<%= line_chart.plot_top %>"
                x2="<%= line_chart.marker_pixel.round(2) %>" y2="<%= line_chart.plot_bottom %>"></line>
          <text x="<%= (line_chart.marker_pixel + 4).round(2) %>" y="<%= line_chart.plot_top + 12 %>">transition</text>
        </g>
      <% end %>
      <path class="chart-line" d="<%= line_chart.path %>"></path>
    </svg>
  <% end %>
</figure>
