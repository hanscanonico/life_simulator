<g class="chart-grid">
  <% chart.y_ticks.each do |tick| %>
    <line x1="<%= chart.plot_left %>" y1="<%= tick.position.round(2) %>"
          x2="<%= chart.plot_right %>" y2="<%= tick.position.round(2) %>"></line>
  <% end %>
</g>
<g class="chart-axis">
  <line x1="<%= chart.plot_left %>" y1="<%= chart.plot_top %>"
        x2="<%= chart.plot_left %>" y2="<%= chart.plot_bottom %>"></line>
  <line x1="<%= chart.plot_left %>" y1="<%= chart.plot_bottom %>"
        x2="<%= chart.plot_right %>" y2="<%= chart.plot_bottom %>"></line>
</g>
<g class="chart-tick-label">
  <% chart.x_ticks.each do |tick| %>
    <text x="<%= chart.x_tick_label_x(tick.position).round(2) %>" y="<%= chart.plot_bottom + 20 %>"
          text-anchor="<%= chart.x_tick_anchor(tick.position) %>"><%= tick.label %></text>
  <% end %>
  <% chart.y_ticks.each do |tick| %>
    <text x="<%= chart.plot_left - 8 %>" y="<%= (tick.position + 5).round(2) %>" text-anchor="end"><%= tick.label %></text>
  <% end %>
</g>
<g class="chart-axis-label">
  <text x="<%= chart.plot_left + (chart.plot_width / 2) %>" y="<%= chart.height - 10 %>" text-anchor="middle"><%= chart.x_label %></text>
  <text class="chart-y-title" x="18" y="<%= chart.plot_top + (chart.plot_height / 2) %>" text-anchor="middle"
        transform="rotate(-90 18 <%= chart.plot_top + (chart.plot_height / 2) %>)"><%= chart.y_label %></text>
</g>
