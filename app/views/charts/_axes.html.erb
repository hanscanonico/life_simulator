<g class="chart-grid">
  <% chart.y_ticks.each do |tick| %>
    <line x1="<%= chart.plot_left %>" y1="<%= tick.position.round(2) %>"
          x2="<%= chart.plot_right %>" y2="<%= tick.position.round(2) %>"></line>
  <% end %>
</g>
<g class="chart-axis">
  <line x1="<%= chart.plot_left %>" y1="<%= chart.plot_top %>"
        x2="<%= chart.plot_left %>" y2="<%= chart.plot_bottom %>"></line>
  <line x1="<%= chart.plot_left %>" y1="<%= chart.plot_bottom %>"
        x2="<%= chart.plot_right %>" y2="<%= chart.plot_bottom %>"></line>
</g>
<g class="chart-tick-label">
  <% chart.x_ticks.each do |tick| %>
    <text x="<%= tick.position.round(2) %>" y="<%= chart.plot_bottom + 16 %>" text-anchor="middle"><%= tick.label %></text>
  <% end %>
  <% chart.y_ticks.each do |tick| %>
    <text x="<%= chart.plot_left - 8 %>" y="<%= (tick.position + 4).round(2) %>" text-anchor="end"><%= tick.label %></text>
  <% end %>
</g>
<g class="chart-axis-label">
  <text x="<%= chart.plot_left + (chart.plot_width / 2) %>" y="<%= chart.height - 6 %>" text-anchor="middle"><%= chart.x_label %></text>
  <text x="14" y="<%= chart.plot_top + (chart.plot_height / 2) %>" text-anchor="middle"
        transform="rotate(-90 14 <%= chart.plot_top + (chart.plot_height / 2) %>)"><%= chart.y_label %></text>
</g>
