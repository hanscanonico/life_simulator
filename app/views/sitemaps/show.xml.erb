<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<% @show.entries.each do |entry| %>
  <url>
    <loc><%= "#{request.base_url}#{entry.path}" %></loc>
    <% if entry.lastmod %>
    <lastmod><%= entry.lastmod.iso8601 %></lastmod>
    <% end %>
  </url>
<% end %>
</urlset>
