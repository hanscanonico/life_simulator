#!/bin/bash -e
# Deploy the latest main to this machine (the mini-pc compose stack).
# Usage: deploy/deploy [--no-pull]
# DEPLOY_REF pins the commit to deploy; defaults to origin/main. Must be a
# fast-forward of the current checkout.
cd "$(dirname "$0")/.."

if [ "${1:-}" != "--no-pull" ]; then
  git fetch origin
  git merge --ff-only "${DEPLOY_REF:-origin/main}"
fi

. deploy/lib.sh

# Must match the `image:` of the app and runner services in docker-compose.yml.
app_image="life-simulator-app:latest"
app_previous="life-simulator-app:previous"
runner_image="life-simulator-runner:latest"
runner_previous="life-simulator-runner:previous"

start_stack() {
  $compose up -d && wait_healthy
}

prune_superseded_images() {
  # Never -a: that would collect the :previous tags, which the rollback branch needs.
  # Housekeeping must not turn a healthy deploy into a failed one, so a prune
  # that cannot run is only reported.
  docker image prune -f --filter "until=168h" >/dev/null ||
    echo "Image prune failed; superseded images were not reclaimed." >&2
}

# Tagged before the build, and taken from the container rather than from the
# :latest tag: the build moves that tag, and an interrupted earlier deploy can
# have left it on an image that never served.
serving_image() {
  local service=$1 image=$2 container serving=""
  container=$($compose ps -q "$service" 2>/dev/null || true)
  if [ -n "$container" ]; then
    serving=$(docker inspect --format '{{.Image}}' "$container" 2>/dev/null || true)
  fi
  # Nothing is running, so fall back to the tag the last build left behind.
  if [ -z "$serving" ] && docker image inspect "$image" >/dev/null 2>&1; then
    serving=$image
  fi
  echo "$serving"
}

serving=$(serving_image app "$app_image")
if [ -n "$serving" ]; then
  docker image tag "$serving" "$app_previous"
fi
runner_serving=$(serving_image runner "$runner_image")
# The deploy that splits the two images finds the runner container still on the
# app image; rolling the runner back to that would run Rails' entrypoint, so the
# runner's own tag is the only candidate then. The app's id is read as well as
# $serving, which is a tag rather than an id whenever no app container is up.
app_id=$(docker image inspect --format '{{.Id}}' "$app_image" 2>/dev/null || true)
if [ -n "$runner_serving" ] &&
   { [ "$runner_serving" = "$serving" ] || [ "$runner_serving" = "$app_id" ]; }; then
  runner_serving=""
  if docker image inspect "$runner_image" >/dev/null 2>&1; then
    runner_serving=$runner_image
  fi
fi
if [ -n "$runner_serving" ]; then
  docker image tag "$runner_serving" "$runner_previous"
fi

# Two images, one build command. The runner is built from the `runner` target,
# whose layers read only the rust-build stage — engine/, the Makefile and the
# wasm-bindgen version pinned in engine/Cargo.lock. An app-only merge changes
# none of those, so BuildKit reuses the cached layers verbatim: the runner image
# keeps the same image ID, `up -d` sees the runner container already on that
# image and leaves it running, and the runs in flight are not interrupted.
$compose build app runner

if start_stack; then
  echo "Deployed and healthy."
  prune_superseded_images
  exit 0
fi

echo "The stack did not come up on the new build." >&2
report_stack

# The one retry that is worth trying before rolling back: `up -d` starts a
# container the first attempt only created, and the build's memory peak is over
# by now.
echo "Retrying the start once..." >&2
if start_stack; then
  echo "Deployed and healthy on the second attempt." >&2
  prune_superseded_images
  exit 0
fi

echo "The stack is still not fully up after the retry." >&2
report_stack
if [ -z "$serving" ]; then
  echo "No previous image to roll back to; the site is down." >&2
  exit 1
fi

echo "Rolling back to the previous images..." >&2
if [ -n "$runner_serving" ]; then
  docker image tag "$runner_previous" "$runner_image" || true
fi
if docker image tag "$app_previous" "$app_image" && start_stack; then
  echo "Rolled back: the previous build is serving again." >&2
else
  echo "The rollback did not bring the whole stack up either. Check: $compose logs app" >&2
  report_stack
fi
exit 1
