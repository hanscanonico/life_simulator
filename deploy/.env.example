# Copy to deploy/.env on the mini-pc and fill in. .env is gitignored.

# Password for the bundled Postgres; also part of the app's DATABASE_URL.
POSTGRES_PASSWORD=

# Contents of config/master.key, to decrypt config/credentials.yml.enc.
RAILS_MASTER_KEY=

# Shared secret the Rust runner presents when it posts results to the app.
RUNNER_TOKEN=

# Runs the runner executes at once. Defaults to 12; the compose limits keep it
# to 14 cores whatever this says.
RUNNER_PARALLELISM=

# Memory the runner claims under; over it, slots wait instead of claiming.
# Defaults to 5g, a gigabyte under the compose memory limit.
RUNNER_MAX_MEMORY=

# How stale a snapshot may get before the next sampled epoch takes one, whatever
# `snapshot_every` says: the ceiling on what a restart recomputes. Defaults to 30m.
RUNNER_SNAPSHOT_MAX_AGE=

# Token for the `life-simulator` Cloudflare tunnel (Zero Trust dashboard).
CLOUDFLARE_TUNNEL_TOKEN=
